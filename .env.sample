# Local development defaults
DJANGO_DEBUG=True

# Prefer a local PostgreSQL database that matches production semantics more closely.
# This default uses the current OS user over the local PostgreSQL socket.
DATABASE_URL=postgresql:///asterproof

# Set your own secret key if you do not want to use the fallback from local settings.
# DJANGO_SECRET_KEY=change-me

# Temporary production bootstrap overrides if you need to bring the site up on plain HTTP
# before a real HTTPS certificate is installed. Leave these unset in steady-state production.
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False

# Production release deployments must load their environment from outside the
# release and keep uploads in a persistent shared directory.
# DJANGO_READ_DOT_ENV_FILE=False
# DJANGO_MEDIA_ROOT=/srv/asterproof/shared/media

# Production defaults to aggregate request/SQL timing in the existing console log.
# Logs omit SQL text, parameters, query strings and user identities.
# DJANGO_REQUEST_TIMING_LOG=False  # optional opt-out
# Compile fixed templates, URL caches and local static manifest before WSGI readiness.
# No user-page rendering, progress queries or background refreshes.
# DJANGO_PREPARE_FIRST_REQUEST=False  # optional opt-out; production defaults on

# Set both identities to enable read-only progress sharing between these two accounts.
# DJANGO_PROGRESS_ALEX_EMAIL=alex@example.com
# DJANGO_PROGRESS_BEN_EMAIL=ben@example.com

# Requires the separate assignment-review schema rollout and verified seed.
CONCEPT_ASSIGNMENTS_ENABLED=False
