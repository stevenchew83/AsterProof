[Unit]
Description=AsterProof bounded newsletter queue worker
Requisite=@APP_SERVICE@
After=@APP_SERVICE@
PartOf=@APP_SERVICE@

[Service]
Type=oneshot
User=@APP_USER@
WorkingDirectory=@CURRENT@
EnvironmentFile=@ENVIRONMENT_FILE@
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=DJANGO_READ_DOT_ENV_FILE=False
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@CURRENT@/.venv/bin/python -B manage.py process_newsletters --max-messages=20 --seconds=50
TimeoutStartSec=75s
TimeoutStopSec=15s
KillMode=control-group
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=256M
MemoryMax=384M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
