[Unit]
Description=AsterProof admin solution review and notification worker
Requisite=@APP_SERVICE@
After=@APP_SERVICE@
PartOf=@APP_SERVICE@

[Service]
Type=exec
User=@APP_USER@
WorkingDirectory=@CURRENT@
EnvironmentFile=@ENVIRONMENT_FILE@
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=DJANGO_READ_DOT_ENV_FILE=False
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@CURRENT@/.venv/bin/python -B manage.py process_admin_solution_reviews --drain
TimeoutStartSec=30s
# Give claimed jobs their five-minute deadline plus time to close the pool.
TimeoutStopSec=330s
KillMode=mixed
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=768M
MemoryMax=1G
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
