[Unit]
Description=AsterProof deployment operation %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Use the system manager's default root identity. Explicit User=root on systemd 255
# with seccomp can discard CAP_SETUID, which is needed to delegate to fixed users.
ExecStart=/usr/local/libexec/asterproof-operation-worker --contract /etc/asterproof/deployment-target.json --run-id %i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/asterproof /usr/local/libexec
ReadWritePaths=@RELEASE_ROOT@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
TimeoutStartSec=30min
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
